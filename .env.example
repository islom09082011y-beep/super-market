# Serverni ishga tushirish porti
PORT=5000

# MongoDB ulanish manzili (local yoki Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/online_magazin

# JWT sozlamalari
JWT_SECRET=juda_maxfiy_kalit_shu_yerga_yoz
JWT_EXPIRES_IN=7d

# Google OAuth (Google Cloud Console -> Credentials dan olinadi)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Frontend manzili (CORS uchun)
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------------------
# AI yordamchi (admin panel). Kalitni https://console.anthropic.com dan oling.
# Kalit bo'lmasa yordamchi "sozlanmagan" deb javob beradi, qolgan sayt ishlayveradi.
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------
# Onlayn to'lov
# PAYMENT_SANDBOX=true  -> o'z saytimizdagi TEST to'lov sahifasi (haqiqiy pul yechilmaydi).
#   Standart: development'da yoqilgan, NODE_ENV=production'da o'chiq.
# Haqiqiy to'lov uchun Click yoki Payme'dan merchant ma'lumotlari kerak:
# ---------------------------------------------------------------
PAYMENT_SANDBOX=true

# Click (https://merchant.click.uz). Click kabinetida manzillarni shunday kiriting:
#   Prepare:  https://SIZNING-DOMEN/api/payments/click/prepare
#   Complete: https://SIZNING-DOMEN/api/payments/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Payme (https://merchant.paycom.uz). Endpoint: https://SIZNING-DOMEN/api/payments/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
# Payme test muhiti uchun: PAYME_TEST=true va PAYME_TEST_KEY=...
PAYME_TEST=false
PAYME_TEST_KEY=
PAYME_ACCOUNT_FIELD=order_id
